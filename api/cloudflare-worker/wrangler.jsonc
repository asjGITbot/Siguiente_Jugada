{
  "name": "siguiente-jugada",
  "main": "accounts-worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "siguiente-jugada-accounts",
      "database_id": "SET_D1_DATABASE_ID_BEFORE_DEPLOYMENT",
      "migrations_dir": "migrations"
    }
  ]
}
